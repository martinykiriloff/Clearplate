# --- Database ---
POSTGRES_USER=clearplate
POSTGRES_PASSWORD=clearplate
POSTGRES_DB=clearplate
DATABASE_URL=postgresql://clearplate:clearplate@localhost:5432/clearplate?schema=public

# --- API ---
API_PORT=4000
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Public URL of the web app (OAuth redirects back here, CORS origin)
WEB_URL=http://localhost:3000
# Public URL of the API (OAuth callback base)
API_URL=http://localhost:4000

# --- Optional social login (leave empty to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Web ---
# URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Paid modules ---
# Access paid outside the app (email:module[,module];...). Modules: barcode, insights, recipes, data, all
ENTITLEMENT_GRANTS=
# Stripe (optional; without it only grants unlock modules)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BARCODE_MONTH=
STRIPE_PRICE_BARCODE_YEAR=
STRIPE_PRICE_ALL_MONTH=
STRIPE_PRICE_ALL_YEAR=
STRIPE_AUTOMATIC_TAX=false
