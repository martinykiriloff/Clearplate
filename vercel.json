{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "installCommand": "sh ../../scripts/vercel-install.sh",
      "buildCommand": "sh ../../scripts/vercel-build-api.sh",
      "functions": {
        "src/main.ts": {
          "includeFiles": "node_modules/swagger-ui-dist/**"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "sh ../../scripts/vercel-install.sh",
      "buildCommand": "pnpm --filter @clearplate/targets build && pnpm --filter @clearplate/web build"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
